# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=release_notifier
DB_USER=app
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=600

# GitHub
GITHUB_TOKEN=
GITHUB_SCAN_INTERVAL=300
GITHUB_SCAN_BATCH_SIZE=100

# SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@release-notifier.local
SMTP_ENCRYPTION=

# API Key Authentication
API_KEY=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Notification DB
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5433
NOTIFICATION_DB_NAME=release_notifications
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=secret

# App
APP_PORT=8080
APP_ENV=production
GRPC_PORT=9001
RUN_MIGRATIONS_ON_BOOT=false

# Welcome-email transport (REST->gRPC migration, Epic 3).
# rabbit (default, async HW9 path) | rest | grpc. Absent/unknown => rabbit.
# The reply leg + timeout sweeper stay on RabbitMQ for ALL transports (only the
# outbound SEND leg migrates), so saga-worker keeps depends_on: rabbitmq.
WELCOME_EMAIL_TRANSPORT=rabbit
NOTIFICATION_GRPC_TARGET=notification-svc:9002
NOTIFICATION_REST_BASE_URL=http://notification-svc:8081
# Sync-path deadline + bounded retry (the broker-buffer/sweeper replacement).
WELCOME_EMAIL_SYNC_DEADLINE_SECONDS=10
WELCOME_EMAIL_SYNC_MAX_ATTEMPTS=3
WELCOME_EMAIL_SYNC_BACKOFF_MS=200,500,1000
