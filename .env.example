# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=release_notifier
DB_USER=app
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=600

# GitHub
GITHUB_TOKEN=
GITHUB_SCAN_INTERVAL=300
GITHUB_SCAN_BATCH_SIZE=100

# SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@release-notifier.local
SMTP_ENCRYPTION=

# API Key Authentication
API_KEY=

# App
APP_PORT=8080
APP_ENV=production
# APP_VERSION: surfaced as the app_info{version} metric label
APP_VERSION=1.0.0
GRPC_PORT=9001
RUN_MIGRATIONS_ON_BOOT=false

# Observability
# LOG_FORMAT: json | line
LOG_FORMAT=json
# LOG_LEVEL: debug|info|notice|warning|error|critical|alert|emergency
LOG_LEVEL=info
# APP_COMPONENT: api | grpc | scanner (set per service in docker-compose.observability.yml)
APP_COMPONENT=api
# METRICS_STORAGE: redis | memory (memory is used by the test suite)
METRICS_STORAGE=redis
