# Notification microservice — environment variables read by config/settings.php
#
# This service reads directly from $_ENV/getenv() (no phpdotenv — see Decision §5
# of story D4): in its real deployment (Docker), docker-compose injects these as
# the container's environment via env_file:, exactly like the monolith's app/
# scanner/grpc services. This file documents the contract for anyone running the
# service standalone or wiring it into compose (D6) — copy to .env for local
# reference; nothing loads it automatically at runtime.

# --- RabbitMQ (broker this service consumes SendReleaseEmail/v1 messages from) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- SMTP (outbound mail transport — PHPMailer/SMTP) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@release-notifier.local
SMTP_ENCRYPTION=

# --- notification-db (this service's OWN Postgres instance — separate from the
# monolith's postgres/DB_*; no FK, no shared connection, see D2/C3) ---
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5433
NOTIFICATION_DB_NAME=release_notifications
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=secret
