{
    "name": "github-release-notifier/notification-service",
    "description": "Standalone email-sending microservice for github-release-notifier",
    "type": "project",
    "require": {
        "php": "^8.2",
        "php-amqplib/php-amqplib": "^3.7",
        "phpmailer/phpmailer": "^6.9",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "vimeo/psalm": "^6",
        "squizlabs/php_codesniffer": "^3",
        "psalm/plugin-phpunit": "^0.19",
        "deptrac/deptrac": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "phpcs",
            "deptrac analyse --no-progress --no-cache"
        ],
        "psalm": "psalm"
    }
}
