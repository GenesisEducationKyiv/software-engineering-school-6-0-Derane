model {
    extend notifier {
        httpApi = container "HTTP API" {
            description "
                Public REST API for subscription CRUD.
                Validates input, talks to repository,
                checks repos against GitHub.
                Exposes /health, /metrics and the static
                HTML subscription form at GET /.
            "
            technology "PHP 8.4, Slim 4, FrankenPHP (Caddy)"
        }

        grpcApi = container "gRPC API" {
            description "
                gRPC adapter over the same business logic.
                Runs on RoadRunner worker protocol.
                Logger writes to stderr to keep stdout clean
                for the worker transport.
            "
            technology "PHP 8.4, RoadRunner, gRPC"
        }

        scanner = container "Scanner Worker" {
            description "
                Background process. Periodically polls
                GitHub for new releases of subscribed repos
                in batches and triggers email notifications.
                Tracks per-repo last-seen tag and per-subscription
                delivery state to avoid duplicate emails.
            "
            technology "PHP 8.4 CLI, long-running loop"
        }

        db = database "PostgreSQL" {
            description "
                Stores subscriptions, per-repository last seen tag
                and per-subscription release_notifications
                (delivery state per release tag).
                Migrations run with advisory lock to prevent
                concurrent schema changes.
            "
            technology "PostgreSQL 16"
        }

        redis = cache "Redis" {
            description "
                Caches GitHub API responses to stay within
                rate limits and reduce latency. Also backs the
                shared Prometheus metrics registry so HTTP, gRPC
                and scanner processes accumulate RED metrics in
                one place.
            "
            technology "Redis 7"
        }

        // --- Observability stack (docker-compose.observability.yml) ---

        filebeat = container "Filebeat" {
            description "
                Tails container stdout/stderr and ships the
                application's structured JSON log lines to
                Elasticsearch.
            "
            technology "Elastic Filebeat 8"
        }

        elasticsearch = database "Elasticsearch" {
            description "
                Stores and indexes structured application logs
                for full-text search and aggregation.
            "
            technology "Elasticsearch 8 (single-node)"
        }

        kibana = container "Kibana" {
            description "
                Search, filter and aggregate logs by correlation
                id, component (api/grpc/scanner) and level.
            "
            technology "Kibana 8"
        }

        prometheus = container "Prometheus" {
            description "
                Scrapes RED and business metrics from the HTTP API
                /metrics endpoint and stores the time series.
            "
            technology "Prometheus 2"
        }

        grafana = container "Grafana" {
            description "
                Visualizes the RED metrics dashboard, querying
                Prometheus as its datasource.
            "
            technology "Grafana 11"
        }
    }

    user -> httpApi "REST calls and HTML subscription form" "HTTPS, JSON, X-API-Key"
    user -> grpcApi "RPC calls" "gRPC"

    httpApi -> db "Reads/writes subscriptions" "SQL/TCP"
    httpApi -> redis "Reads/writes cached GitHub responses" "RESP"
    httpApi -> github "Validates owner/repo exists" "HTTPS"

    grpcApi -> db "Reads/writes subscriptions" "SQL/TCP"
    grpcApi -> redis "Reads/writes cached GitHub responses" "RESP"
    grpcApi -> github "Validates owner/repo exists" "HTTPS"

    scanner -> db "Reads subscriptions, updates delivery state" "SQL/TCP"
    scanner -> redis "Reads/writes cached GitHub responses" "RESP"
    scanner -> github "Polls release metadata" "HTTPS"
    scanner -> smtp "Sends email notifications" "SMTP"

    // Structured logging pipeline: each process emits JSON to stdout, Filebeat
    // ships it to Elasticsearch, Kibana reads it back for search/aggregation.
    httpApi -> filebeat "Emits structured JSON logs" "stdout"
    grpcApi -> filebeat "Emits structured JSON logs" "stdout"
    scanner -> filebeat "Emits structured JSON logs" "stdout"
    filebeat -> elasticsearch "Ships logs" "Bulk HTTP"
    kibana -> elasticsearch "Queries & visualizes logs" "HTTP"

    // Metrics pipeline: processes publish RED metrics into the shared Redis-backed
    // registry; the HTTP API renders it at /metrics; Prometheus scrapes it; Grafana reads.
    httpApi -> redis "Publishes RED metrics (shared registry)" "RESP"
    grpcApi -> redis "Publishes RED metrics (shared registry)" "RESP"
    scanner -> redis "Publishes RED metrics (shared registry)" "RESP"
    prometheus -> httpApi "Scrapes metrics" "HTTP /metrics"
    grafana -> prometheus "Queries metrics" "HTTP"
}
