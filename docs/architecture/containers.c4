model {
    extend notifier {
        httpApi = container "HTTP API" {
            description "
                Public REST API for subscription CRUD.
                Builds commands/queries and uses the monolith
                database plus cached GitHub lookups.
            "
            technology "PHP 8.4, Slim 4, FrankenPHP (Caddy)"
        }

        grpcApi = container "gRPC API" {
            description "
                gRPC adapter over the same business logic.
                Runs on RoadRunner worker protocol.
                Logger writes to stderr to keep stdout clean
                for the worker transport.
            "
            technology "PHP 8.4, RoadRunner, gRPC"
        }

        scanner = container "Scanner Worker" {
            description "
                Background process. Polls GitHub for new releases,
                resolves subscribers, and publishes one
                SendReleaseEmail/v1 command per subscriber to RabbitMQ.
                Advances last_seen_tag only after publish succeeds.
            "
            technology "PHP 8.4 CLI, long-running loop"
        }

        sagaWorker = container "Saga Worker" {
            description "
                Orchestrated-saga worker (monolith image). One supervised
                loop runs three responsibilities: the outbox relay
                (publishes SendWelcomeEmail/v1 for STARTED sagas with
                publisher confirms), the WelcomeEmailOutcome reply consumer
                (confirms or compensates the saga + subscription status),
                and the timeout sweeper. Saga state lives in the existing
                monolith PostgreSQL — no new database.
            "
            technology "PHP 8.4 CLI, long-running loop"
        }

        notificationSvc = container "Notification Service" {
            description "
                Queue consumer for SendReleaseEmail/v1 and SendWelcomeEmail/v1.
                Dedupes delivery in its own database, renders email,
                sends via MailHog/SMTP, and publishes WelcomeEmailOutcome/v1
                replies back to the monolith saga worker.
            "
            technology "PHP 8.2 CLI worker"
        }

        db = database "Monolith PostgreSQL" {
            description "
                Stores subscriptions and tracked repositories.
                The monolith no longer owns release_notifications.
            "
            technology "PostgreSQL 16"
        }

        notificationDb = database "Notification PostgreSQL" {
            description "
                Stores release_notifications and notification_metrics
                for the notification service.
            "
            technology "PostgreSQL 16"
        }

        redis = cache "Redis" {
            description "
                Caches GitHub API responses to stay within
                rate limits and reduce latency.
            "
            technology "Redis 7"
        }

        rabbitmq = container "RabbitMQ" {
            description "
                Durable notifications exchange + send-email queue
                + dead-letter queue for failed messages.
            "
            technology "RabbitMQ 4"
        }

        mailhog = container "MailHog" {
            description "
                Local SMTP sink and mailbox viewer used by
                notification-svc in development.
            "
            technology "MailHog"
        }
    }

    user -> httpApi "REST calls and HTML subscription form" "HTTPS, JSON, X-API-Key"
    user -> grpcApi "RPC calls" "gRPC"

    httpApi -> db "Reads/writes subscriptions" "SQL/TCP"
    httpApi -> redis "Reads/writes cached GitHub responses" "RESP"
    httpApi -> github "Validates owner/repo exists" "HTTPS"

    grpcApi -> db "Reads/writes subscriptions" "SQL/TCP"
    grpcApi -> redis "Reads/writes cached GitHub responses" "RESP"
    grpcApi -> github "Validates owner/repo exists" "HTTPS"

    scanner -> db "Reads subscriptions and scan progress" "SQL/TCP"
    scanner -> redis "Reads/writes cached GitHub responses" "RESP"
    scanner -> github "Polls release metadata" "HTTPS"
    scanner -> rabbitmq "Publishes SendReleaseEmail/v1" "AMQP"

    sagaWorker -> db "Reads/writes enrollment_sagas + subscription status" "SQL/TCP"
    sagaWorker -> rabbitmq "Publishes SendWelcomeEmail/v1, consumes WelcomeEmailOutcome/v1" "AMQP"

    notificationSvc -> rabbitmq "Consumes notifications.send-email + welcome-email / DLQ; publishes WelcomeEmailOutcome/v1" "AMQP"
    notificationSvc -> notificationDb "Reads/writes delivery + welcome ledgers + metrics" "SQL/TCP"
    notificationSvc -> mailhog "Sends email in local dev" "SMTP"
}
