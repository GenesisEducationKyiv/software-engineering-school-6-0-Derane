specification {
    element actor {
        style {
            shape person
            color green
        }
    }

    element externalSystem {
        style {
            shape rectangle
            color secondary
        }
    }

    element system {
        style {
            shape rectangle
            color primary
        }
    }

    element container {
        style {
            shape rectangle
            color blue
        }
    }

    element database {
        style {
            shape cylinder
            color amber
        }
    }

    element cache {
        style {
            shape cylinder
            color red
        }
    }

    element component {
        style {
            shape rectangle
            color sky
        }
    }

    element staticAsset {
        style {
            shape browser
            color slate
        }
    }

    // --- Code-structure view family (layer separation, HW: architecture docs) ---
    // These kinds model the static structure of the codebases (bounded contexts
    // and Clean Architecture layers, mirroring deptrac.yaml), not runtime processes.

    element codebase {
        style {
            shape rectangle
            color muted
        }
    }

    element boundedContext {
        style {
            shape rectangle
            color indigo
        }
    }

    element layer {
        style {
            shape rectangle
            color sky
        }
    }

    element contract {
        style {
            shape storage
            color amber
        }
    }

    relationship async
    relationship sync
}
