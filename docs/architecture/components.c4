model {
    extend notifier.httpApi {
        middleware = component "HTTP Middleware Pipeline" {
            description "
                PSR-15 stack for /api, /health, /metrics, and the
                HTML form entrypoint.
            "
            technology "PHP, PSR-15"
        }

        subscriptionCtrl = component "SubscriptionController" {
            description "REST handlers for /api/subscriptions CRUD."
            technology "PHP, Slim 4"
        }

        healthCtrl = component "HealthController" {
            description "Liveness/readiness endpoint."
            technology "PHP, Slim 4"
        }

        metricsCtrl = component "MetricsController" {
            description "Exposes Prometheus metrics."
            technology "PHP, Slim 4"
        }

        commandBus = component "CommandBus" {
            description "
                In-memory command bus dispatching subscription
                and repository-tracking commands.
            "
            technology "PHP"
        }

        queryBus = component "QueryBus" {
            description "In-memory query bus for subscription reads."
            technology "PHP, Guzzle"
        }

        releaseSource = component "ReleaseSource" {
            description "GitHub release/repository source with Redis-backed caching."
            technology "PHP, Guzzle"
        }

        metricsSvc = component "MetricsService" {
            description "
                Aggregates Prometheus gauges from count ports.
            "
            technology "PHP"
        }

        subscriptionRepo = component "SubscriptionRepository" {
            description "PDO adapter for subscriptions and subscriber lookup."
            technology "PHP, PDO"
        }

        middleware -> subscriptionCtrl "Forwards authenticated /api/* requests"
        middleware -> healthCtrl "Forwards GET /health"
        middleware -> metricsCtrl "Forwards GET /metrics"
        subscriptionCtrl -> commandBus "Dispatches writes"
        subscriptionCtrl -> queryBus "Dispatches reads"
        metricsCtrl -> metricsSvc "Renders Prometheus exposition"
        metricsSvc -> subscriptionRepo "Reads aggregate counts on every scrape"
        commandBus -> releaseSource "Validates owner/repo exists during subscribe"
        commandBus -> subscriptionRepo "Persists subscriptions"
        queryBus -> subscriptionRepo "Reads subscriptions"
    }

    extend notifier.grpcApi {
        grpcSvc = component "ReleaseNotifierService" {
            description "
                gRPC service implementation:
                Health, CreateSubscription, ListSubscriptions,
                GetSubscription, DeleteSubscription. Maps domain
                exceptions to gRPC status codes.
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcCommandBus = component "CommandBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcQueryBus = component "QueryBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcRepo = component "SubscriptionRepository" {
            description "gRPC-side runtime instance of the subscription repository."
            technology "PHP, PDO"
        }

        grpcSvc -> grpcCommandBus "Dispatches writes"
        grpcSvc -> grpcQueryBus "Dispatches reads"
        grpcCommandBus -> grpcRepo "Persists subscriptions"
        grpcQueryBus -> grpcRepo "Reads subscriptions"
    }

    user -> notifier.grpcApi.grpcSvc "RPC calls" "gRPC"

    extend notifier.scanner {
        cliRunner = component "ScannerCliRunner" {
            description "
                Long-running loop that dispatches ScanReleases commands.
            "
            technology "PHP CLI"
        }

        scanHandler = component "ScanReleasesHandler" {
            description "
                Orchestrates the scan cycle, dispatches
                NewReleaseDetected, and advances markers only
                after publish succeeds.
            "
            technology "PHP"
        }

        releaseDetector = component "ReleaseDetector" {
            description "Compares GitHub releases against repository scan state."
            technology "PHP, Guzzle"
        }

        publishListener = component "WhenNewReleaseDetectedThenPublishReleaseEmails" {
            description "
                Thin adapter: maps NewReleaseDetected into the Publishing
                context's ReleaseSnapshot and delegates to the use-case.
            "
            technology "PHP"
        }

        publishUseCase = component "PublishReleaseEmailsForRelease" {
            description "
                Publishing use-case: resolves subscribers and builds one
                SendReleaseEmail/v1 message per recipient, published as
                a single batch.
            "
            technology "PHP"
        }

        scannerRepo = component "SubscriptionRepository" {
            description "
                Scanner-side access to subscriptions and tracked repositories.
            "
            technology "PHP, PDO"
        }

        rabbitPublisher = component "RabbitReleaseNotificationPublisher" {
            description "Publishes SendReleaseEmail/v1 batches to RabbitMQ."
            technology "PHP, AMQP"
        }

        cliRunner -> scanHandler "Dispatches scan command"
        scanHandler -> scannerRepo "Reads due repositories and updates scan state"
        scanHandler -> releaseDetector "Resolves latest release"
        scanHandler -> publishListener "Triggers publish via NewReleaseDetected"
        publishListener -> publishUseCase "Delegates repository + release snapshot"
        publishUseCase -> scannerRepo "Resolves the repository's subscribers"
        publishUseCase -> rabbitPublisher "Publishes the batch with one confirm-wait"
    }

    user -> notifier.httpApi.middleware "All HTTP requests (outermost edge)" "HTTPS"

    notifier.httpApi.healthCtrl -> notifier.db "SELECT 1 (liveness probe)" "SQL/TCP"
    notifier.httpApi.releaseSource -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.httpApi.releaseSource -> github "Calls REST API" "HTTPS"
    notifier.httpApi.subscriptionRepo -> notifier.db "SQL" "TCP"

    notifier.grpcApi.grpcSvc -> notifier.db "SELECT 1 on Health() (liveness)" "SQL/TCP"
    notifier.grpcApi.grpcRepo -> notifier.db "SQL" "TCP"

    notifier.scanner.releaseDetector -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.scanner.releaseDetector -> github "Calls REST API" "HTTPS"
    notifier.scanner.scannerRepo -> notifier.db "SQL" "TCP"
    notifier.scanner.rabbitPublisher -> notifier.rabbitmq "Publishes SendReleaseEmail/v1" "AMQP"

    extend notifier.sagaWorker {
        sagaLoop = component "SagaWorker" {
            description "
                Supervised loop (bin/saga-worker.php). Each tick relays
                pending welcome emails, waits to consume WelcomeEmailOutcome,
                and periodically sweeps timed-out sagas. exit(1) on connection
                loss for restart-driven re-derivation from the durable rows.
            "
            technology "PHP CLI, AMQP"
        }

        relayUseCase = component "RelayPendingWelcomeEmails" {
            description "
                Outbox relay use-case: selects STARTED sagas and publishes
                one SendWelcomeEmail/v1 each with publisher confirms, advancing
                the saga to AWAITING_CONFIRMATION only after a confirmed publish.
            "
            technology "PHP"
        }

        welcomeRelay = component "RabbitWelcomeEmailRelay" {
            description "
                Publishes SendWelcomeEmail/v1 to RabbitMQ with publisher
                confirms; throws on an unconfirmed publish so the saga is
                not advanced (retried next tick).
            "
            technology "PHP, AMQP"
        }

        outcomeConsumer = component "WelcomeEmailOutcomeConsumer" {
            description "
                Reply consumer: validates WelcomeEmailOutcome/v1 against the
                expected schema and dispatches HandleWelcomeEmailOutcomeCommand.
                Acks-and-drops malformed or no-op replies (no DLX).
            "
            technology "PHP, AMQP"
        }

        sagaCommandBus = component "CommandBus" {
            description "
                In-memory command bus for the reply path. Separate runtime
                instance from HTTP/gRPC, same bus pattern.
            "
            technology "PHP"
        }

        outcomeHandler = component "HandleWelcomeEmailOutcomeHandler" {
            description "
                Orchestrator: in one Postgres-A transaction applies the paired
                conditional UPDATEs — subscription status (confirm/cancel) and
                saga state (complete/compensate). rowCount()=0 on both is an
                idempotent no-op (ack-and-drop).
            "
            technology "PHP"
        }

        sweepUseCase = component "SweepTimedOutSagas" {
            description "
                Timeout sweeper: compensates AWAITING_CONFIRMATION sagas past
                awaiting_since + T, and STARTED sagas past created_at + T_start
                (the broker-down backstop) so every saga converges.
            "
            technology "PHP"
        }

        sagaRepo = component "PdoEnrollmentSagaRepository" {
            description "
                PDO adapter implementing the EnrollmentSaga Starter/Reader/Writer
                ports over the enrollment_sagas store; conditional UPDATEs guard
                every state transition.
            "
            technology "PHP, PDO"
        }

        confirmationWriter = component "PdoSubscriptionConfirmationWriter" {
            description "
                Saga-side adapter for the Subscription.Domain confirmation port:
                conditional UPDATE subscriptions SET status WHERE status='pending'
                (confirm/cancel).
            "
            technology "PHP, PDO"
        }

        sagaLoop -> relayUseCase "Relays pending welcome emails each tick"
        sagaLoop -> outcomeConsumer "Consumes WelcomeEmailOutcome/v1"
        sagaLoop -> sweepUseCase "Sweeps timed-out sagas periodically"
        relayUseCase -> sagaRepo "Reads STARTED sagas, marks published"
        relayUseCase -> welcomeRelay "Publishes SendWelcomeEmail/v1 (confirmed)"
        outcomeConsumer -> sagaCommandBus "Dispatches HandleWelcomeEmailOutcomeCommand"
        sagaCommandBus -> outcomeHandler "Handles the reply command"
        outcomeHandler -> sagaRepo "complete/compensate saga (conditional)"
        outcomeHandler -> confirmationWriter "confirm/cancel subscription (conditional)"
        sweepUseCase -> sagaRepo "Reads due sagas, compensates"
        sweepUseCase -> confirmationWriter "Cancels swept subscriptions"
    }

    notifier.sagaWorker.sagaRepo -> notifier.db "SQL (enrollment_sagas)" "TCP"
    notifier.sagaWorker.confirmationWriter -> notifier.db "SQL (subscriptions.status)" "TCP"
    notifier.sagaWorker.welcomeRelay -> notifier.rabbitmq "Publishes SendWelcomeEmail/v1 (confirms)" "AMQP"
    notifier.sagaWorker.outcomeConsumer -> notifier.rabbitmq "Consumes notifications.welcome-email-reply" "AMQP"

    extend notifier.notificationSvc {
        consumer = component "SendReleaseEmailConsumer" {
            description "
                RabbitMQ consumer with ack/nack handling; transient
                failures go to a TTL retry queue (delay grows per
                attempt), claim contention parks for the lease window
                without burning retry budget, poison messages and
                exhausted retries go to the DLQ.
            "
            technology "PHP, AMQP"
        }

        sendEmailHandler = component "SendReleaseEmailHandler" {
            description "
                Idempotency gate: atomically claim the notification in
                the ledger, render email, send mail, mark delivered —
                or skip as dedupe / back off while another worker
                holds the claim.
            "
            technology "PHP"
        }

        ledger = component "PdoNotificationLedger" {
            description "
                Service-owned delivery ledger with an atomic
                INSERT … ON CONFLICT claim per business key.
            "
            technology "PHP, PDO"
        }

        renderer = component "ReleaseEmailRenderer" {
            description "Maps the integration payload into rendered email."
            technology "PHP"
        }

        mailer = component "PhpMailerMailer" {
            description "SMTP adapter used by the notification service."
            technology "PHP, PHPMailer"
        }

        welcomeConsumer = component "SendWelcomeEmailConsumer" {
            description "
                Second RabbitMQ consumer (registered as a second basic_consume).
                Validates SendWelcomeEmail/v1 and invokes the welcome handler;
                same bounded-retry/DLQ envelope as the release consumer.
            "
            technology "PHP, AMQP"
        }

        welcomeHandler = component "SendWelcomeEmailHandler" {
            description "
                Welcome path: claim (keyed by subscriptionId) -> render ->
                send -> markSent -> publish WelcomeEmailOutcome{sent}. On
                terminal failure marks terminal_failed_at, publishes
                WelcomeEmailOutcome{failed}, then DLQs (FR7).
            "
            technology "PHP"
        }

        welcomeLedger = component "PdoWelcomeNotificationLedger" {
            description "
                Welcome delivery ledger keyed by subscription_id (UNIQUE);
                atomic INSERT … ON CONFLICT claim with terminal_failed_at
                guard. Four ClaimOutcome cases (Claimed, InFlight, AlreadySent,
                AlreadyFailed).
            "
            technology "PHP, PDO"
        }

        welcomeRenderer = component "WelcomeEmailRenderer" {
            description "Renders the welcome email subject/body from SendWelcomeEmail/v1."
            technology "PHP"
        }

        outcomePublisher = component "RabbitWelcomeOutcomePublisher" {
            description "
                The service's first publisher: a fail-closed confirm-mode
                channel that publishes WelcomeEmailOutcome/v1 back to the
                monolith on subscription.welcome-email.reply.
            "
            technology "PHP, AMQP"
        }

        consumer -> sendEmailHandler "Invokes for each consumed message"
        sendEmailHandler -> ledger "Claims + records delivery"
        sendEmailHandler -> renderer "Builds subject/body"
        sendEmailHandler -> mailer "Sends email"

        welcomeConsumer -> welcomeHandler "Invokes for each consumed welcome message"
        welcomeHandler -> welcomeLedger "Claims + records welcome delivery"
        welcomeHandler -> welcomeRenderer "Builds welcome subject/body"
        welcomeHandler -> mailer "Sends welcome email"
        welcomeHandler -> outcomePublisher "Publishes WelcomeEmailOutcome/v1"
    }

    notifier.notificationSvc.consumer -> notifier.rabbitmq "Consumes queue / routes poison messages to DLQ" "AMQP"
    notifier.notificationSvc.ledger -> notifier.notificationDb "SQL" "TCP"
    notifier.notificationSvc.mailer -> notifier.mailhog "Sends email in local dev" "SMTP"

    notifier.notificationSvc.welcomeConsumer -> notifier.rabbitmq "Consumes notifications.welcome-email / DLQ" "AMQP"
    notifier.notificationSvc.welcomeLedger -> notifier.notificationDb "SQL (welcome_notifications)" "TCP"
    notifier.notificationSvc.outcomePublisher -> notifier.rabbitmq "Publishes WelcomeEmailOutcome/v1 (confirms)" "AMQP"
}
