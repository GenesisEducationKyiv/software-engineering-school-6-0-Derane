model {
    extend notifier.httpApi {
        // Edge — PSR-15 middleware pipeline
        middleware = component "HTTP Middleware Pipeline" {
            description "
                PSR-15 stack (outermost first): CorrelationId → RequestMetrics →
                ErrorHandler → Routing → RouteTag → ApiKey → BodyParser.
                Mints/propagates a correlation id, records HTTP RED metrics and a
                structured access log for every request.
            "
            technology "PHP, PSR-15"
        }

        httpMetrics = component "HTTP Metrics Recorder" {
            description "
                Records http_requests_total and http_request_duration_seconds into
                the shared Redis-backed Prometheus registry.
            "
            technology "PHP, promphp"
        }

        // Controllers
        subscriptionCtrl = component "SubscriptionController" {
            description "REST handlers for /api/subscriptions CRUD."
            technology "PHP, Slim 4"
        }

        healthCtrl = component "HealthController" {
            description "Liveness/readiness endpoint."
            technology "PHP, Slim 4"
        }

        metricsCtrl = component "MetricsController" {
            description "Exposes the Prometheus exposition at /metrics."
            technology "PHP, Slim 4"
        }

        // Application services
        subscriptionSvc = component "SubscriptionService" {
            description "
                Core business logic: validates email and owner/repo, checks
                GitHub, persists the subscription, and publishes a
                SubscriptionCreated / SubscriptionDeleted application event.
            "
            technology "PHP"
        }

        githubSvc = component "GitHubService" {
            description "GitHub REST adapter with Redis-backed cache."
            technology "PHP, Guzzle"
        }

        metricsSvc = component "MetricsService" {
            description "
                Renders the whole promphp registry on each /metrics scrape:
                HTTP/gRPC/scanner RED series plus business gauges (subscriptions,
                tracked repositories, repositories with releases) read from the DB.
            "
            technology "PHP, promphp"
        }

        // Observability — application-event plane
        eventPublisher = component "EventPublisher" {
            description "
                Fail-open, no-throw fan-out of application events to observability
                sinks: a listener failure never changes the business outcome.
            "
            technology "PHP"
        }

        eventLogger = component "ApplicationEventLogger" {
            description "
                Turns application events into structured stderr logs with a stable
                event= field and masked email addresses (PII redaction).
            "
            technology "PHP, Monolog"
        }

        // Persistence
        subscriptionRepo = component "SubscriptionRepository" {
            description "Data access for the subscriptions table."
            technology "PHP, PDO"
        }

        metricsRepo = component "MetricsRepository" {
            description "
                Reads the aggregate counts (subscriptions, tracked repositories,
                repositories with releases) behind the business gauges.
            "
            technology "PHP, PDO"
        }

        // Static assets (served by Slim, not part of the JSON API)
        homePage = staticAsset "HTML Subscription Form" {
            description "Static public/index.html served by Slim at GET /. Submits to /api/subscriptions."
            technology "Static HTML, served by Slim 4"
        }

        middleware -> subscriptionCtrl "Forwards authenticated /api/* requests"
        middleware -> healthCtrl "Forwards GET /health"
        middleware -> metricsCtrl "Forwards GET /metrics"
        middleware -> homePage "Serves GET / (static)"
        middleware -> httpMetrics "Records request rate / errors / duration"
        subscriptionCtrl -> subscriptionSvc "Delegates business logic"
        metricsCtrl -> metricsSvc "Renders Prometheus exposition"
        metricsSvc -> metricsRepo "Reads aggregate counts on every scrape"
        subscriptionSvc -> githubSvc "Verifies owner/repo exists"
        subscriptionSvc -> subscriptionRepo "Persists / loads subscriptions"
        subscriptionSvc -> eventPublisher "Publishes SubscriptionCreated / Deleted"
        eventPublisher -> eventLogger "Fans out to the log sink"
    }

    extend notifier.grpcApi {
        measuredInvoker = component "MeasuredInvoker" {
            description "
                RoadRunner Invoker decorator — the single dispatch seam. Per call:
                mints/propagates a correlation id, records gRPC RED metrics, and
                emits a structured access log.
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcMetrics = component "gRPC Metrics Recorder" {
            description "
                Records grpc_server_handled_total and grpc_server_handling_seconds
                into the shared Redis-backed Prometheus registry.
            "
            technology "PHP, promphp"
        }

        grpcSvc = component "ReleaseNotifierService" {
            description "
                gRPC service implementation:
                Health, CreateSubscription, ListSubscriptions,
                GetSubscription, DeleteSubscription. Maps domain
                exceptions to gRPC status codes.
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcSubscriptionSvc = component "SubscriptionService" {
            description "
                Same SubscriptionService class as in HTTP API,
                but a separate runtime instance — bin/grpc.php
                builds its own DI container at process start.
            "
            technology "PHP"
        }

        grpcGithubSvc = component "GitHubService" {
            description "Separate scanner/grpc-side instance of the GitHub adapter."
            technology "PHP, Guzzle"
        }

        grpcSubscriptionRepo = component "SubscriptionRepository" {
            description "Separate gRPC-side instance of the subscriptions repository."
            technology "PHP, PDO"
        }

        grpcEventPublisher = component "EventPublisher" {
            description "gRPC-side fail-open application-event publisher (separate instance)."
            technology "PHP"
        }

        grpcEventLogger = component "ApplicationEventLogger" {
            description "gRPC-side structured event logger with masked emails."
            technology "PHP, Monolog"
        }

        measuredInvoker -> grpcSvc "Dispatches each RPC"
        measuredInvoker -> grpcMetrics "Records call rate / errors / duration"
        grpcSvc -> grpcSubscriptionSvc "Delegates business logic"
        grpcSubscriptionSvc -> grpcGithubSvc "Verifies owner/repo exists"
        grpcSubscriptionSvc -> grpcSubscriptionRepo "Persists / loads subscriptions"
        grpcSubscriptionSvc -> grpcEventPublisher "Publishes SubscriptionCreated / Deleted"
        grpcEventPublisher -> grpcEventLogger "Fans out to the log sink"
    }

    user -> notifier.grpcApi.measuredInvoker "RPC calls" "gRPC"

    extend notifier.scanner {
        scannerSvc = component "ScannerService" {
            description "
                Loop driver / orchestrator. Pulls a batch of due repositories,
                delegates detection and notification, advances scan markers, and
                publishes scan-lifecycle application events. Holds no direct
                logging or metrics dependency.
            "
            technology "PHP CLI"
        }

        releaseDetector = component "ReleaseDetector" {
            description "
                Resolves the latest release tag from GitHub, compares against
                repositories.last_seen_tag, and publishes ReleaseDetected when the
                tag differs.
            "
            technology "PHP"
        }

        notificationDispatcher = component "NotificationDispatcher" {
            description "
                Finds subscribers for a repository, skips already-delivered tags via
                the release_notifications ledger, and sends each email through
                NotifierService.
            "
            technology "PHP"
        }

        notifierSvc = component "NotifierService" {
            description "
                Renders and sends the release email via SMTP, publishing
                ReleaseNotificationSent / Failed per recipient.
            "
            technology "PHP, PHPMailer"
        }

        scannerGithub = component "GitHubService" {
            description "Same GitHubService class, scanner-side instance."
            technology "PHP, Guzzle"
        }

        scannerRepo = component "Scanner Repositories" {
            description "
                Per-consumer PDO data access for the scan loop: candidate source
                (due repos), progress writer (last_seen_tag / last_checked_at),
                repository-status reader, subscriber finder, and the
                release_notifications delivery ledger.
            "
            technology "PHP, PDO"
        }

        scannerEventPublisher = component "EventPublisher" {
            description "Scanner-side fail-open application-event publisher (separate instance)."
            technology "PHP"
        }

        scanMetricsListener = component "ScanMetricsListener" {
            description "
                Translates scan events (cycle completed, repository failed, rate
                limited, release detected, notification result) into the scanner
                RED / throughput metrics.
            "
            technology "PHP, promphp"
        }

        scannerEventLogger = component "ApplicationEventLogger" {
            description "Scanner-side structured event logger with masked emails."
            technology "PHP, Monolog"
        }

        scannerSvc -> scannerRepo "Reads scan candidates, advances markers"
        scannerSvc -> releaseDetector "Detects a new release per repo"
        scannerSvc -> notificationDispatcher "Dispatches notifications for a release"
        scannerSvc -> scannerEventPublisher "Publishes scan-cycle events"
        releaseDetector -> scannerGithub "Resolves latest release"
        releaseDetector -> scannerRepo "Reads last_seen_tag"
        releaseDetector -> scannerEventPublisher "Publishes ReleaseDetected"
        notificationDispatcher -> scannerRepo "Finds subscribers, dedups via ledger"
        notificationDispatcher -> notifierSvc "Sends release email"
        notifierSvc -> scannerEventPublisher "Publishes notification result"
        scannerEventPublisher -> scanMetricsListener "Fans out to the metrics sink"
        scannerEventPublisher -> scannerEventLogger "Fans out to the log sink"
    }

    user -> notifier.httpApi.middleware "All HTTP requests (outermost edge)" "HTTPS"

    // --- Cross-scope relationships ---
    notifier.httpApi.healthCtrl -> notifier.db "SELECT 1 (liveness probe)" "SQL/TCP"
    notifier.httpApi.githubSvc -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.httpApi.githubSvc -> github "Calls REST API" "HTTPS"
    notifier.httpApi.subscriptionRepo -> notifier.db "SQL" "TCP"
    notifier.httpApi.metricsRepo -> notifier.db "Aggregate count queries" "SQL/TCP"
    notifier.httpApi.httpMetrics -> notifier.redis "Writes HTTP RED series (shared registry)" "RESP"
    notifier.httpApi.metricsSvc -> notifier.redis "Reads all RED series for exposition" "RESP"

    notifier.grpcApi.grpcSvc -> notifier.db "SELECT 1 on Health() (liveness)" "SQL/TCP"
    notifier.grpcApi.grpcGithubSvc -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.grpcApi.grpcGithubSvc -> github "Calls REST API" "HTTPS"
    notifier.grpcApi.grpcSubscriptionRepo -> notifier.db "SQL" "TCP"
    notifier.grpcApi.grpcMetrics -> notifier.redis "Writes gRPC RED series (shared registry)" "RESP"

    notifier.scanner.scannerGithub -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.scanner.scannerGithub -> github "Calls REST API" "HTTPS"
    notifier.scanner.scannerRepo -> notifier.db "SQL" "TCP"
    notifier.scanner.notifierSvc -> smtp "Sends email" "SMTP"
    notifier.scanner.scanMetricsListener -> notifier.redis "Writes scanner RED series (shared registry)" "RESP"
}
