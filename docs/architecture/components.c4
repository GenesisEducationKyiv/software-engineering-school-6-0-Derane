model {
    extend notifier.httpApi {
        middleware = component "HTTP Middleware Pipeline" {
            description "
                PSR-15 stack for /api, /health, /metrics, and the
                HTML form entrypoint.
            "
            technology "PHP, PSR-15"
        }

        subscriptionCtrl = component "SubscriptionController" {
            description "REST handlers for /api/subscriptions CRUD."
            technology "PHP, Slim 4"
        }

        healthCtrl = component "HealthController" {
            description "Liveness/readiness endpoint."
            technology "PHP, Slim 4"
        }

        metricsCtrl = component "MetricsController" {
            description "Exposes Prometheus metrics."
            technology "PHP, Slim 4"
        }

        commandBus = component "CommandBus" {
            description "
                In-memory command bus dispatching subscription
                and repository-tracking commands.
            "
            technology "PHP"
        }

        queryBus = component "QueryBus" {
            description "In-memory query bus for subscription reads."
            technology "PHP, Guzzle"
        }

        releaseSource = component "ReleaseSource" {
            description "GitHub release/repository source with Redis-backed caching."
            technology "PHP, Guzzle"
        }

        metricsSvc = component "MetricsService" {
            description "
                Aggregates Prometheus gauges from count ports.
            "
            technology "PHP"
        }

        subscriptionRepo = component "SubscriptionRepository" {
            description "PDO adapter for subscriptions and subscriber lookup."
            technology "PHP, PDO"
        }

        middleware -> subscriptionCtrl "Forwards authenticated /api/* requests"
        middleware -> healthCtrl "Forwards GET /health"
        middleware -> metricsCtrl "Forwards GET /metrics"
        subscriptionCtrl -> commandBus "Dispatches writes"
        subscriptionCtrl -> queryBus "Dispatches reads"
        metricsCtrl -> metricsSvc "Renders Prometheus exposition"
        metricsSvc -> subscriptionRepo "Reads aggregate counts on every scrape"
        commandBus -> releaseSource "Validates owner/repo exists during subscribe"
        commandBus -> subscriptionRepo "Persists subscriptions"
        queryBus -> subscriptionRepo "Reads subscriptions"
    }

    extend notifier.grpcApi {
        grpcSvc = component "ReleaseNotifierService" {
            description "
                gRPC service implementation:
                Health, CreateSubscription, ListSubscriptions,
                GetSubscription, DeleteSubscription. Maps domain
                exceptions to gRPC status codes.
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcCommandBus = component "CommandBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcQueryBus = component "QueryBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcRepo = component "SubscriptionRepository" {
            description "gRPC-side runtime instance of the subscription repository."
            technology "PHP, PDO"
        }

        grpcSvc -> grpcCommandBus "Dispatches writes"
        grpcSvc -> grpcQueryBus "Dispatches reads"
        grpcCommandBus -> grpcRepo "Persists subscriptions"
        grpcQueryBus -> grpcRepo "Reads subscriptions"
    }

    user -> notifier.grpcApi.grpcSvc "RPC calls" "gRPC"

    extend notifier.scanner {
        cliRunner = component "ScannerCliRunner" {
            description "
                Long-running loop that dispatches ScanReleases commands.
            "
            technology "PHP CLI"
        }

        scanHandler = component "ScanReleasesHandler" {
            description "
                Orchestrates the scan cycle, dispatches
                NewReleaseDetected, and advances markers only
                after publish succeeds.
            "
            technology "PHP"
        }

        releaseDetector = component "ReleaseDetector" {
            description "Compares GitHub releases against repository scan state."
            technology "PHP, Guzzle"
        }

        publishListener = component "WhenNewReleaseDetectedThenPublishReleaseEmails" {
            description "
                Resolves subscribers and maps each one into a
                SendReleaseEmail/v1 command for RabbitMQ.
            "
            technology "PHP"
        }

        scannerRepo = component "SubscriptionRepository" {
            description "
                Scanner-side access to subscriptions and tracked repositories.
            "
            technology "PHP, PDO"
        }

        rabbitPublisher = component "RabbitReleaseNotificationPublisher" {
            description "Publishes SendReleaseEmail/v1 to RabbitMQ."
            technology "PHP, AMQP"
        }

        cliRunner -> scanHandler "Dispatches scan command"
        scanHandler -> scannerRepo "Reads due repositories and updates scan state"
        scanHandler -> releaseDetector "Resolves latest release"
        scanHandler -> publishListener "Triggers publish via NewReleaseDetected"
        publishListener -> rabbitPublisher "Publishes one message per subscriber"
    }

    user -> notifier.httpApi.middleware "All HTTP requests (outermost edge)" "HTTPS"

    notifier.httpApi.healthCtrl -> notifier.db "SELECT 1 (liveness probe)" "SQL/TCP"
    notifier.httpApi.releaseSource -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.httpApi.releaseSource -> github "Calls REST API" "HTTPS"
    notifier.httpApi.subscriptionRepo -> notifier.db "SQL" "TCP"

    notifier.grpcApi.grpcSvc -> notifier.db "SELECT 1 on Health() (liveness)" "SQL/TCP"
    notifier.grpcApi.grpcRepo -> notifier.db "SQL" "TCP"

    notifier.scanner.releaseDetector -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.scanner.releaseDetector -> github "Calls REST API" "HTTPS"
    notifier.scanner.scannerRepo -> notifier.db "SQL" "TCP"
    notifier.scanner.rabbitPublisher -> notifier.rabbitmq "Publishes SendReleaseEmail/v1" "AMQP"

    extend notifier.notificationSvc {
        consumer = component "SendReleaseEmailConsumer" {
            description "RabbitMQ consumer with ack/nack/DLQ handling."
            technology "PHP, AMQP"
        }

        sendEmailHandler = component "SendReleaseEmailHandler" {
            description "
                Idempotency gate: check ledger, render email,
                send mail, mark delivered or deduped.
            "
            technology "PHP"
        }

        ledger = component "PdoNotificationLedger" {
            description "Service-owned delivery ledger."
            technology "PHP, PDO"
        }

        renderer = component "ReleaseEmailRenderer" {
            description "Maps the integration payload into rendered email."
            technology "PHP"
        }

        mailer = component "PhpMailerMailer" {
            description "SMTP adapter used by the notification service."
            technology "PHP, PHPMailer"
        }

        consumer -> sendEmailHandler "Invokes for each consumed message"
        sendEmailHandler -> ledger "Checks + records delivery"
        sendEmailHandler -> renderer "Builds subject/body"
        sendEmailHandler -> mailer "Sends email"
    }

    notifier.notificationSvc.consumer -> notifier.rabbitmq "Consumes queue / routes poison messages to DLQ" "AMQP"
    notifier.notificationSvc.ledger -> notifier.notificationDb "SQL" "TCP"
    notifier.notificationSvc.mailer -> notifier.mailhog "Sends email in local dev" "SMTP"
}
