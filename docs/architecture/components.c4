model {
    extend notifier.httpApi {
        middleware = component "HTTP Middleware Pipeline" {
            description "
                PSR-15 stack for /api, /health, /metrics, and the
                HTML form entrypoint.
            "
            technology "PHP, PSR-15"
        }

        subscriptionCtrl = component "SubscriptionController" {
            description "REST handlers for /api/subscriptions CRUD."
            technology "PHP, Slim 4"
        }

        healthCtrl = component "HealthController" {
            description "Liveness/readiness endpoint."
            technology "PHP, Slim 4"
        }

        metricsCtrl = component "MetricsController" {
            description "Exposes Prometheus metrics."
            technology "PHP, Slim 4"
        }

        commandBus = component "CommandBus" {
            description "
                In-memory command bus dispatching subscription
                and repository-tracking commands.
            "
            technology "PHP"
        }

        queryBus = component "QueryBus" {
            description "In-memory query bus for subscription reads."
            technology "PHP"
        }

        releaseSource = component "ReleaseSource" {
            description "GitHub release/repository source with Redis-backed caching."
            technology "PHP, Guzzle"
        }

        metricsSvc = component "MetricsService" {
            description "
                Aggregates Prometheus gauges from four count/reader ports on
                every /metrics scrape: subscriptions, tracked repositories,
                saga states, and saga event counters.
            "
            technology "PHP"
        }

        subscriptionRepo = component "PdoSubscriptionRepository" {
            description "
                PDO adapter implementing the narrow subscription ports
                (SubscriptionRepository, SubscriberFinder, SubscriptionCountPort).
            "
            technology "PHP, PDO"
        }

        trackedRepoWriter = component "PdoTrackedRepositoryWriter" {
            description "
                RepositoryTracking adapter: ensureExists(owner/repo) during
                subscribe (TrackedRepositoryRegistrar port).
            "
            technology "PHP, PDO"
        }

        sagaStore = component "PdoEnrollmentSagaRepository" {
            description "
                Saga store: the subscribe handler starts the enrollment saga in
                the SAME transaction as the subscription insert
                (EnrollmentSagaStarter port); also serves the saga-state gauges
                (EnrollmentSagaCountPort).
            "
            technology "PHP, PDO"
        }

        trackedRepoReader = component "PdoTrackedRepositoryReader" {
            description "Serves the tracked-repository count gauge (RepositoryCountPort)."
            technology "PHP, PDO"
        }

        sagaMetricsStore = component "PdoSagaMetricsStore" {
            description "
                Reads saga event counters off the saga_metrics read-model
                (SagaMetricsReader port).
            "
            technology "PHP, PDO"
        }

        middleware -> subscriptionCtrl "Forwards authenticated /api/* requests"
        middleware -> healthCtrl "Forwards GET /health"
        middleware -> metricsCtrl "Forwards GET /metrics"
        subscriptionCtrl -> commandBus "Dispatches writes"
        subscriptionCtrl -> queryBus "Dispatches reads"
        metricsCtrl -> metricsSvc "Renders Prometheus exposition"
        metricsSvc -> subscriptionRepo "Subscription count gauge"
        metricsSvc -> trackedRepoReader "Repository count gauge"
        metricsSvc -> sagaStore "Saga state gauges"
        metricsSvc -> sagaMetricsStore "Saga event counters"
        commandBus -> releaseSource "Validates owner/repo exists during subscribe"
        commandBus -> trackedRepoWriter "ensureExists(owner/repo) during subscribe"
        commandBus -> subscriptionRepo "Persists subscriptions"
        commandBus -> sagaStore "Starts the enrollment saga (same transaction)"
        queryBus -> subscriptionRepo "Reads subscriptions"
    }

    extend notifier.grpcApi {
        grpcSvc = component "ReleaseNotifierService" {
            description "
                gRPC service implementation:
                Health, CreateSubscription, ListSubscriptions,
                GetSubscription, DeleteSubscription. Maps domain
                exceptions to gRPC status codes.
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcCommandBus = component "CommandBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcQueryBus = component "QueryBus" {
            description "Separate runtime instance from HTTP, same bus pattern."
            technology "PHP"
        }

        grpcReleaseSource = component "ReleaseSource" {
            description "
                gRPC-side runtime instance of the GitHub release/repository
                source with Redis-backed caching.
            "
            technology "PHP, Guzzle"
        }

        grpcRepo = component "PdoSubscriptionRepository" {
            description "gRPC-side runtime instance of the PDO subscription adapter."
            technology "PHP, PDO"
        }

        grpcTrackedRepoWriter = component "PdoTrackedRepositoryWriter" {
            description "
                gRPC-side runtime instance registering tracked repositories
                during subscribe (TrackedRepositoryRegistrar port).
            "
            technology "PHP, PDO"
        }

        grpcSagaStore = component "PdoEnrollmentSagaRepository" {
            description "
                gRPC-side runtime instance starting the enrollment saga in the
                SAME transaction as the subscription insert.
            "
            technology "PHP, PDO"
        }

        grpcSvc -> grpcCommandBus "Dispatches writes"
        grpcSvc -> grpcQueryBus "Dispatches reads"
        grpcCommandBus -> grpcReleaseSource "Validates owner/repo exists during subscribe"
        grpcCommandBus -> grpcTrackedRepoWriter "ensureExists(owner/repo) during subscribe"
        grpcCommandBus -> grpcRepo "Persists subscriptions"
        grpcCommandBus -> grpcSagaStore "Starts the enrollment saga (same transaction)"
        grpcQueryBus -> grpcRepo "Reads subscriptions"
    }

    user -> notifier.grpcApi.grpcSvc "RPC calls" "gRPC"

    extend notifier.scanner {
        cliRunner = component "ScannerCliRunner" {
            description "
                Long-running loop that dispatches ScanReleases commands.
            "
            technology "PHP CLI"
        }

        scanHandler = component "ScanReleasesHandler" {
            description "
                Orchestrates the scan cycle, dispatches
                NewReleaseDetected, and advances markers only
                after publish succeeds.
            "
            technology "PHP"
        }

        releaseDetector = component "ReleaseDetector" {
            description "
                Compares the latest GitHub release (via the ReleaseSource port)
                against the repository's last_seen_tag to decide whether a new
                release appeared.
            "
            technology "PHP"
        }

        scannerReleaseSource = component "GitHubApiReleaseSource" {
            description "
                Releases-context adapter behind the ReleaseSource port: GitHub
                REST client wrapped in the Redis-backed cache stack.
            "
            technology "PHP, Guzzle, Predis"
        }

        publishListener = component "WhenNewReleaseDetectedThenPublishReleaseEmails" {
            description "
                Thin adapter: maps NewReleaseDetected into the Publishing
                context's ReleaseSnapshot and delegates to the use-case.
            "
            technology "PHP"
        }

        publishUseCase = component "PublishReleaseEmailsForRelease" {
            description "
                Publishing use-case: resolves subscribers and builds one
                SendReleaseEmail/v1 message per recipient, published as
                a single batch.
            "
            technology "PHP"
        }

        scannerRepoReader = component "PdoTrackedRepositoryReader" {
            description "
                RepositoryTracking adapter: scan candidates and last_seen_tag
                reads (ScanCandidateSource / RepositoryStatusReader ports).
            "
            technology "PHP, PDO"
        }

        scannerRepoWriter = component "PdoTrackedRepositoryWriter" {
            description "
                RepositoryTracking adapter: advances last_seen_tag after a
                successful publish (ScanProgressWriter port).
            "
            technology "PHP, PDO"
        }

        scannerSubscriptionRepo = component "PdoSubscriptionRepository" {
            description "Resolves the repository's subscribers (SubscriberFinder port)."
            technology "PHP, PDO"
        }

        rabbitPublisher = component "RabbitReleaseNotificationPublisher" {
            description "Publishes SendReleaseEmail/v1 batches to RabbitMQ."
            technology "PHP, AMQP"
        }

        cliRunner -> scanHandler "Dispatches scan command"
        scanHandler -> scannerRepoReader "Reads due repositories (ScanCandidateSource)"
        scanHandler -> releaseDetector "Resolves latest release"
        releaseDetector -> scannerReleaseSource "getLatestRelease via ReleaseSource port"
        releaseDetector -> scannerRepoReader "Reads last_seen_tag (RepositoryStatusReader)"
        scanHandler -> scannerRepoWriter "Advances last_seen_tag only after publish succeeds"
        scanHandler -> publishListener "Triggers publish via NewReleaseDetected"
        publishListener -> publishUseCase "Delegates repository + release snapshot"
        publishUseCase -> scannerSubscriptionRepo "Resolves the repository's subscribers"
        publishUseCase -> rabbitPublisher "Publishes the batch with one confirm-wait"
    }

    user -> notifier.httpApi.middleware "All HTTP requests (outermost edge)" "HTTPS"

    notifier.httpApi.healthCtrl -> notifier.db "SELECT 1 (liveness probe)" "SQL/TCP"
    notifier.httpApi.releaseSource -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.httpApi.releaseSource -> github "Calls REST API" "HTTPS"
    notifier.httpApi.subscriptionRepo -> notifier.db "SQL (subscriptions)" "TCP"
    notifier.httpApi.trackedRepoWriter -> notifier.db "SQL (repositories)" "TCP"
    notifier.httpApi.trackedRepoReader -> notifier.db "SQL (repositories)" "TCP"
    notifier.httpApi.sagaStore -> notifier.db "SQL (enrollment_sagas)" "TCP"
    notifier.httpApi.sagaMetricsStore -> notifier.db "SQL (saga_metrics)" "TCP"

    notifier.grpcApi.grpcSvc -> notifier.db "SELECT 1 on Health() (liveness)" "SQL/TCP"
    notifier.grpcApi.grpcReleaseSource -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.grpcApi.grpcReleaseSource -> github "Calls REST API" "HTTPS"
    notifier.grpcApi.grpcRepo -> notifier.db "SQL (subscriptions)" "TCP"
    notifier.grpcApi.grpcTrackedRepoWriter -> notifier.db "SQL (repositories)" "TCP"
    notifier.grpcApi.grpcSagaStore -> notifier.db "SQL (enrollment_sagas)" "TCP"

    notifier.scanner.scannerReleaseSource -> notifier.redis "Reads/writes cached responses" "RESP"
    notifier.scanner.scannerReleaseSource -> github "Calls REST API" "HTTPS"
    notifier.scanner.scannerRepoReader -> notifier.db "SQL (repositories)" "TCP"
    notifier.scanner.scannerRepoWriter -> notifier.db "SQL (repositories.last_seen_tag)" "TCP"
    notifier.scanner.scannerSubscriptionRepo -> notifier.db "SQL (subscriptions)" "TCP"
    notifier.scanner.rabbitPublisher -> notifier.rabbitmq "Publishes SendReleaseEmail/v1" "AMQP"

    extend notifier.sagaWorker {
        sagaLoop = component "SagaWorker" {
            description "
                Supervised loop (bin/saga-worker.php). Each tick relays
                pending welcome emails, waits to consume WelcomeEmailOutcome,
                and periodically sweeps timed-out sagas. exit(1) on connection
                loss for restart-driven re-derivation from the durable rows.
            "
            technology "PHP CLI, AMQP"
        }

        relayUseCase = component "RelayPendingWelcomeEmails" {
            description "
                Outbox relay use-case — the SINGLE relay for all three
                transports: selects STARTED sagas and hands each
                SendWelcomeEmail to whichever WelcomeEmailRelay adapter the
                container bound (WELCOME_EMAIL_TRANSPORT=rabbit|rest|grpc),
                advancing the saga to AWAITING_CONFIRMATION only after the
                relay reports success.
            "
            technology "PHP"
        }

        welcomeRelay = component "RabbitWelcomeEmailRelay" {
            description "
                WelcomeEmailRelay adapter: publishes SendWelcomeEmail/v1 to
                RabbitMQ with publisher confirms; throws on an unconfirmed
                publish so the saga is not advanced (retried next tick).
                Bound when WELCOME_EMAIL_TRANSPORT=rabbit (default, async).
            "
            technology "PHP, AMQP"
        }

        restWelcomeRelay = component "RestWelcomeEmailRelay" {
            description "
                Synchronous WelcomeEmailRelay adapter. POSTs JSON to the
                notification REST endpoint via Guzzle with a per-call deadline
                and bounded retry, blocks for sent|failed, then dispatches
                HandleWelcomeEmailOutcomeCommand itself on a definitive
                outcome. Bound when WELCOME_EMAIL_TRANSPORT=rest.
            "
            technology "PHP, Guzzle"
        }

        grpcWelcomeRelay = component "GrpcWelcomeEmailRelay" {
            description "
                Synchronous WelcomeEmailRelay adapter. Wraps the generated
                WelcomeEmailServiceClient (gRPC/ext-grpc) with a call deadline
                and bounded retry on UNAVAILABLE/DEADLINE_EXCEEDED, maps the
                wire Outcome to sent|failed, then dispatches
                HandleWelcomeEmailOutcomeCommand itself on a definitive
                outcome. Bound when WELCOME_EMAIL_TRANSPORT=grpc.
            "
            technology "PHP, gRPC"
        }

        outcomeConsumer = component "WelcomeEmailOutcomeConsumer" {
            description "
                Reply consumer: validates WelcomeEmailOutcome/v1 against the
                expected schema and dispatches HandleWelcomeEmailOutcomeCommand.
                Acks-and-drops malformed or no-op replies (no DLX).
            "
            technology "PHP, AMQP"
        }

        sagaCommandBus = component "CommandBus" {
            description "
                In-memory command bus for the reply path. Separate runtime
                instance from HTTP/gRPC, same bus pattern.
            "
            technology "PHP"
        }

        outcomeHandler = component "HandleWelcomeEmailOutcomeHandler" {
            description "
                Orchestrator: in one Postgres-A transaction applies the paired
                conditional UPDATEs — subscription status (confirm/cancel) and
                saga state (complete/compensate). rowCount()=0 on both is an
                idempotent no-op (ack-and-drop).
            "
            technology "PHP"
        }

        sweepUseCase = component "SweepTimedOutSagas" {
            description "
                Timeout sweeper: compensates AWAITING_CONFIRMATION sagas past
                awaiting_since + T, and STARTED sagas past created_at + T_start
                (the broker-down backstop) so every saga converges.
            "
            technology "PHP"
        }

        sagaRepo = component "PdoEnrollmentSagaRepository" {
            description "
                PDO adapter implementing the EnrollmentSaga Starter/Reader/Writer
                ports over the enrollment_sagas store; conditional UPDATEs guard
                every state transition.
            "
            technology "PHP, PDO"
        }

        confirmationWriter = component "PdoSubscriptionConfirmationWriter" {
            description "
                Saga-side adapter for the Subscription.Domain confirmation port:
                conditional UPDATE subscriptions SET status WHERE status='pending'
                (confirm/cancel).
            "
            technology "PHP, PDO"
        }

        sagaLoop -> relayUseCase "Relays pending welcome emails each tick"
        sagaLoop -> outcomeConsumer "Consumes WelcomeEmailOutcome/v1"
        sagaLoop -> sweepUseCase "Sweeps timed-out sagas periodically"
        relayUseCase -> sagaRepo "Reads STARTED sagas, marks published"
        relayUseCase -> welcomeRelay "publish(SendWelcomeEmail) — transport=rabbit (default)"
        relayUseCase -> restWelcomeRelay "publish(SendWelcomeEmail) — transport=rest (opt-in)"
        relayUseCase -> grpcWelcomeRelay "publish(SendWelcomeEmail) — transport=grpc (opt-in)"
        restWelcomeRelay -> sagaCommandBus "Dispatches HandleWelcomeEmailOutcomeCommand on a definitive outcome"
        grpcWelcomeRelay -> sagaCommandBus "Dispatches HandleWelcomeEmailOutcomeCommand on a definitive outcome"
        outcomeConsumer -> sagaCommandBus "Dispatches HandleWelcomeEmailOutcomeCommand"
        sagaCommandBus -> outcomeHandler "Handles the reply command"
        outcomeHandler -> sagaRepo "complete/compensate saga (conditional)"
        outcomeHandler -> confirmationWriter "confirm/cancel subscription (conditional)"
        sweepUseCase -> sagaRepo "Reads due sagas, compensates"
        sweepUseCase -> confirmationWriter "Cancels swept subscriptions"
    }

    notifier.sagaWorker.sagaRepo -> notifier.db "SQL (enrollment_sagas)" "TCP"
    notifier.sagaWorker.confirmationWriter -> notifier.db "SQL (subscriptions.status)" "TCP"
    notifier.sagaWorker.welcomeRelay -> notifier.rabbitmq "Publishes SendWelcomeEmail/v1 (confirms)" "AMQP"
    notifier.sagaWorker.outcomeConsumer -> notifier.rabbitmq "Consumes notifications.welcome-email-reply" "AMQP"

    notifier.sagaWorker.restWelcomeRelay -> notifier.notificationSvc.welcomeRestController "POST /internal/welcome-emails (sync, caller-waits sent|failed)" "HTTPS, JSON"
    notifier.sagaWorker.grpcWelcomeRelay -> notifier.notificationGrpc.welcomeGrpcSvc "SendWelcomeEmail RPC (sync, caller-waits sent|failed)" "gRPC, HTTP/2"

    extend notifier.notificationSvc {
        consumer = component "SendReleaseEmailConsumer" {
            description "
                RabbitMQ consumer with ack/nack handling; transient
                failures go to a TTL retry queue (delay grows per
                attempt), claim contention parks for the lease window
                without burning retry budget, poison messages and
                exhausted retries go to the DLQ.
            "
            technology "PHP, AMQP"
        }

        sendEmailHandler = component "SendReleaseEmailHandler" {
            description "
                Idempotency gate: atomically claim the notification in
                the ledger, render email, send mail, mark delivered —
                or skip as dedupe / back off while another worker
                holds the claim.
            "
            technology "PHP"
        }

        ledger = component "PdoNotificationLedger" {
            description "
                Service-owned delivery ledger with an atomic
                INSERT … ON CONFLICT claim per business key.
            "
            technology "PHP, PDO"
        }

        renderer = component "ReleaseEmailRenderer" {
            description "Maps the integration payload into rendered email."
            technology "PHP"
        }

        mailer = component "PhpMailerMailer" {
            description "SMTP adapter used by the notification service."
            technology "PHP, PHPMailer"
        }

        welcomeConsumer = component "SendWelcomeEmailConsumer" {
            description "
                Second RabbitMQ consumer (registered as a second basic_consume).
                Validates SendWelcomeEmail/v1 and invokes the welcome handler;
                same bounded-retry/DLQ envelope as the release consumer, plus
                two welcome-only arms: already-terminal rows go straight to
                the DLQ, and an unconfirmed failed-reply publish exits the
                worker for a restart (fail-closed).
            "
            technology "PHP, AMQP"
        }

        welcomeHandler = component "SendWelcomeEmailHandler" {
            description "
                Welcome path: claim (keyed by subscriptionId) -> render ->
                send -> markSent -> publish WelcomeEmailOutcome{sent}. On
                terminal failure marks terminal_failed_at and publishes
                WelcomeEmailOutcome{failed}; the consumer then routes the
                message to the DLQ (FR7).
            "
            technology "PHP"
        }

        welcomeLedger = component "PdoWelcomeNotificationLedger" {
            description "
                Welcome delivery ledger keyed by subscription_id (UNIQUE);
                atomic INSERT … ON CONFLICT claim with terminal_failed_at
                guard. Four ClaimOutcome cases (Claimed, InFlight, AlreadySent,
                AlreadyFailed).
            "
            technology "PHP, PDO"
        }

        welcomeRenderer = component "WelcomeEmailRenderer" {
            description "Renders the welcome email subject/body from SendWelcomeEmail/v1."
            technology "PHP"
        }

        outcomePublisher = component "RabbitWelcomeOutcomePublisher" {
            description "
                The service's first publisher: a fail-closed confirm-mode
                channel that publishes WelcomeEmailOutcome/v1 back to the
                monolith (rk subscription.welcome-email.reply -> queue
                notifications.welcome-email-reply).
            "
            technology "PHP, AMQP"
        }

        metricsStore = component "PdoNotificationMetricsStore" {
            description "
                Records message-processing and delivery stats
                (MessageProcessingStatsRecorder / WelcomeProcessingStatsRecorder /
                DeliveryOutcomeRecorder ports) into notification_metrics —
                the data behind the service's /metrics surface.
            "
            technology "PHP, PDO"
        }

        welcomeRestController = component "WelcomeEmailController" {
            description "
                Synchronous REST baseline (POST /internal/welcome-emails) on
                the php -S HTTP surface. Validates the JSON shape, builds the
                WelcomeEmail VO, invokes the unchanged SendWelcomeEmailHandler
                class — wired with a no-op outcome publisher, so the caller
                applies the outcome in-thread and no Rabbit reply fires — and
                returns sent|failed (409 on in-flight contention). Error
                mapping via ExceptionStatusMap::toHttpStatus().
            "
            technology "PHP, Slim 4"
        }

        consumer -> sendEmailHandler "Invokes for each consumed message"
        consumer -> metricsStore "Records processing stats"
        welcomeConsumer -> metricsStore "Records processing stats"
        sendEmailHandler -> metricsStore "Records delivery outcome"
        welcomeHandler -> metricsStore "Records welcome delivery outcome"
        sendEmailHandler -> ledger "Claims + records delivery"
        sendEmailHandler -> renderer "Builds subject/body"
        sendEmailHandler -> mailer "Sends email"

        welcomeConsumer -> welcomeHandler "Invokes for each consumed welcome message"
        welcomeRestController -> welcomeHandler "Invokes the unchanged handler on POST /internal/welcome-emails"
        welcomeHandler -> welcomeLedger "Claims + records welcome delivery"
        welcomeHandler -> welcomeRenderer "Builds welcome subject/body"
        welcomeHandler -> mailer "Sends welcome email"
        welcomeHandler -> outcomePublisher "Publishes WelcomeEmailOutcome/v1"
    }

    notifier.notificationSvc.consumer -> notifier.rabbitmq "Consumes queue / routes poison messages to DLQ" "AMQP"
    notifier.notificationSvc.ledger -> notifier.notificationDb "SQL" "TCP"
    notifier.notificationSvc.mailer -> notifier.mailhog "Sends email in local dev" "SMTP"

    notifier.notificationSvc.welcomeConsumer -> notifier.rabbitmq "Consumes notifications.welcome-email / DLQ" "AMQP"
    notifier.notificationSvc.welcomeLedger -> notifier.notificationDb "SQL (welcome_notifications)" "TCP"
    notifier.notificationSvc.metricsStore -> notifier.notificationDb "SQL (notification_metrics)" "TCP"
    notifier.notificationSvc.outcomePublisher -> notifier.rabbitmq "Publishes WelcomeEmailOutcome/v1 (confirms)" "AMQP"

    extend notifier.notificationGrpc {
        welcomeGrpcSvc = component "WelcomeEmailGrpcService" {
            description "
                Spiral gRPC service implementing the generated
                WelcomeEmailServiceInterface (unary SendWelcomeEmail). Derives
                sent|failed from the handler's dispositions; maps exceptions to
                gRPC status codes via ExceptionStatusMap::toGrpcStatus()
                (WelcomeInFlightException -> ABORTED, validation ->
                INVALID_ARGUMENT, else INTERNAL/UNAVAILABLE).
            "
            technology "PHP, RoadRunner gRPC"
        }

        grpcWelcomeHandler = component "SendWelcomeEmailHandler" {
            description "
                gRPC-side runtime instance of the unchanged welcome handler
                (bin/grpc.php builds its own DI container), wired with a
                no-op outcome publisher — the RPC caller applies the outcome,
                no Rabbit reply fires. Same claim -> render -> send ->
                markSent flow as the consumer-side instance.
            "
            technology "PHP"
        }

        grpcWelcomeLedger = component "PdoWelcomeNotificationLedger" {
            description "
                gRPC-side runtime instance of the welcome delivery ledger
                keyed by subscription_id (UNIQUE); atomic INSERT … ON CONFLICT
                claim with terminal_failed_at guard.
            "
            technology "PHP, PDO"
        }

        grpcWelcomeRenderer = component "WelcomeEmailRenderer" {
            description "
                gRPC-side runtime instance of the welcome email renderer.
            "
            technology "PHP"
        }

        grpcWelcomeMailer = component "PhpMailerMailer" {
            description "
                gRPC-side runtime instance of the SMTP adapter.
            "
            technology "PHP, PHPMailer"
        }

        grpcMetricsStore = component "PdoNotificationMetricsStore" {
            description "
                gRPC-side runtime instance recording welcome processing and
                delivery stats into notification_metrics.
            "
            technology "PHP, PDO"
        }

        welcomeGrpcSvc -> grpcWelcomeHandler "Invokes the unchanged handler per SendWelcomeEmail RPC"
        grpcWelcomeHandler -> grpcWelcomeLedger "Claims + records welcome delivery"
        grpcWelcomeHandler -> grpcWelcomeRenderer "Builds welcome subject/body"
        grpcWelcomeHandler -> grpcWelcomeMailer "Sends welcome email"
        grpcWelcomeHandler -> grpcMetricsStore "Records welcome delivery outcome"
    }

    notifier.notificationGrpc.grpcWelcomeLedger -> notifier.notificationDb "SQL (welcome_notifications)" "TCP"
    notifier.notificationGrpc.grpcMetricsStore -> notifier.notificationDb "SQL (notification_metrics)" "TCP"
    notifier.notificationGrpc.grpcWelcomeMailer -> notifier.mailhog "Sends welcome email in local dev" "SMTP"
}
