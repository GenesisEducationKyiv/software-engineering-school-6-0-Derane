views {
    view index {
        title "System Landscape"
        description "
            Subscriber, GitHub, and the system boundary.
        "
        include
            user,
            github,
            notifier
    }

    view containers of notifier {
        title "Container View — GitHub Release Notifier"
        description "
            Final runtime topology after notification-service extraction.
        "
        include
            *,
            user,
            github
    }

    view httpApiComponents of notifier.httpApi {
        title "Component View — HTTP API"
        description "
            HTTP edge and its bus/repository integration points.
        "
        include
            *,
            user,
            notifier.db,
            notifier.redis,
            github
    }

    view scannerComponents of notifier.scanner {
        title "Component View — Scanner Worker"
        description "
            Scanner-side publish path into RabbitMQ.
        "
        include
            *,
            notifier.db,
            notifier.redis,
            github,
            notifier.rabbitmq
    }

    view grpcApiComponents of notifier.grpcApi {
        title "Component View — gRPC API"
        description "
            Components inside the gRPC API container.
            bin/grpc.php builds its own DI container, so the buses,
            ReleaseSource and the PDO adapters are separate runtime
            instances from the HTTP API.
        "
        include
            *,
            user,
            notifier.db,
            notifier.redis,
            github
    }

    view notificationServiceComponents of notifier.notificationSvc {
        title "Component View — Notification Service"
        description "
            Release + welcome consumers, handlers, ledgers, renderers, mailer,
            and the welcome-outcome publisher inside apps/notification.
        "
        include
            *,
            notifier.rabbitmq,
            notifier.notificationDb,
            notifier.mailhog
    }

    view sagaWorkerComponents of notifier.sagaWorker {
        title "Component View — Saga Worker"
        description "
            Outbox relay, reply consumer + orchestrator, timeout sweeper, and
            the two opt-in synchronous welcome-email relays (rest/grpc) inside
            the monolith saga-worker; saga state in the monolith PostgreSQL.
        "
        include
            *,
            notifier.db,
            notifier.rabbitmq,
            notifier.notificationSvc.welcomeRestController,
            notifier.notificationGrpc.welcomeGrpcSvc
    }

    view contextMap of monolithCode {
        title "Code View — Bounded-Context Map (Monolith)"
        description "
            DDD context map of the monolith codebase: bounded contexts,
            the shared kernel, the strangler remainder, and the wire-contract
            seam to the extracted notification service. Every arrow is an
            allowed dependency in deptrac.yaml; anything else fails composer lint.
        "
        include
            *,
            wireContracts,
            notificationCode
    }

    view monolithLayers of monolithCode {
        title "Code View — Clean Architecture Layers (Monolith)"
        description "
            Layer separation per bounded context: Domain (green) <- Application
            (blue) <- Infrastructure (grey), dependency rule pointing inward.
            Cross-context edges are the explicit port grants from deptrac.yaml;
            shared-kernel usage is drawn per context (exact ring rule enforced
            by deptrac per layer).
        "
        include
            *,
            monolithCode.sharedKernel.*,
            monolithCode.subscription.*,
            monolithCode.repositoryTracking.*,
            monolithCode.releases.*,
            monolithCode.scanning.*,
            monolithCode.saga.*,
            monolithCode.notificationPublishing.*,
            monolithCode.legacy.*
    }

    view notificationLayers of notificationCode {
        title "Code View — Clean Architecture Layers (Notification Service)"
        description "
            Internal layering of the extracted service, enforced by its own
            apps/notification/deptrac.yaml. The service shares no code with the
            monolith — only the versioned wire contracts.
        "
        include
            *,
            notificationCode.sending.*,
            wireContracts
    }

    view notificationGrpcComponents of notifier.notificationGrpc {
        title "Component View — Notification gRPC Server"
        description "
            RoadRunner gRPC server (:9002) serving
            notification.welcome.v1.WelcomeEmailService over its own DI
            container (handler/ledger/renderer/mailer are separate runtime
            instances from the consumer-side notification service).
        "
        include
            *,
            notifier.notificationDb,
            notifier.mailhog
    }

    dynamic view createSubscriptionFlow {
        title "Dynamic — Create Subscription"
        description "HTTP subscription flow through controller, buses, GitHub validation, and persistence."
        user -> notifier.httpApi.middleware "POST /api/subscriptions with X-API-Key"
        notifier.httpApi.middleware -> notifier.httpApi.subscriptionCtrl "Authenticated, forward to controller"
        notifier.httpApi.subscriptionCtrl -> notifier.httpApi.commandBus "dispatch SubscribeCommand"
        notifier.httpApi.commandBus -> notifier.httpApi.releaseSource "repositoryExists(owner/repo)?"
        notifier.httpApi.releaseSource -> notifier.redis "GET cached response"
        notifier.httpApi.releaseSource -> github "GET /repos/{owner}/{repo} (on cache miss)"
        notifier.httpApi.releaseSource -> notifier.redis "SET response (on cache miss)"
        notifier.httpApi.commandBus -> notifier.httpApi.trackedRepoWriter "ensureExists(owner/repo)"
        notifier.httpApi.trackedRepoWriter -> notifier.db "INSERT INTO repositories ON CONFLICT DO NOTHING"
        notifier.httpApi.commandBus -> notifier.httpApi.subscriptionRepo "create(email, owner/repo) — ONE transaction with the saga start"
        notifier.httpApi.subscriptionRepo -> notifier.db "INSERT INTO subscriptions ON CONFLICT DO NOTHING RETURNING ... (status defaults to pending)"
        notifier.httpApi.commandBus -> notifier.httpApi.sagaStore "start enrollment saga (same transaction)"
        notifier.httpApi.sagaStore -> notifier.db "INSERT INTO enrollment_sagas (state=started)"
        notifier.httpApi.subscriptionCtrl -> notifier.httpApi.queryBus "ask FindSubscriptionByEmailAndRepository (build the 201 body)"
        notifier.httpApi.queryBus -> notifier.httpApi.subscriptionRepo "read back the created subscription"
        notifier.httpApi.subscriptionCtrl -> user "201 Created"
    }

    dynamic view publishAndSendFlow {
        title "Dynamic — Publish And Send Release Notification"
        description "
            Scanner-side publish followed by notification-service consume,
            dedupe, and SMTP delivery.
        "

        notifier.scanner.cliRunner -> notifier.scanner.scanHandler "dispatch ScanReleasesCommand"
        notifier.scanner.scanHandler -> notifier.scanner.scannerRepoReader "getDueForScan(batchSize)"
        notifier.scanner.scannerRepoReader -> notifier.db "SELECT repositories"
        notifier.scanner.scanHandler -> notifier.scanner.releaseDetector "detect new release for owner/repo"
        notifier.scanner.releaseDetector -> notifier.scanner.scannerReleaseSource "getLatestRelease(owner/repo)"
        notifier.scanner.scannerReleaseSource -> notifier.redis "GET cached response"
        notifier.scanner.scannerReleaseSource -> github "GET /repos/.../releases/latest (on cache miss)"
        notifier.scanner.scannerReleaseSource -> notifier.redis "SET response with TTL (on cache miss)"
        notifier.scanner.releaseDetector -> notifier.scanner.scannerRepoReader "read last_seen_tag"
        notifier.scanner.scannerRepoReader -> notifier.db "SELECT last_seen_tag"
        notifier.scanner.scanHandler -> notifier.scanner.publishListener "dispatch NewReleaseDetected"
        notifier.scanner.publishListener -> notifier.scanner.publishUseCase "publish(repository, release snapshot)"
        notifier.scanner.publishUseCase -> notifier.scanner.scannerSubscriptionRepo "findSubscribersByRepository(repo)"
        notifier.scanner.scannerSubscriptionRepo -> notifier.db "SELECT subscribers"
        notifier.scanner.publishUseCase -> notifier.scanner.rabbitPublisher "publishAll: SendReleaseEmail/v1 batch, one per subscriber"
        notifier.scanner.rabbitPublisher -> notifier.rabbitmq "Publish batch (rk release.email -> queue notifications.send-email, single confirm-wait)"
        notifier.scanner.scanHandler -> notifier.scanner.scannerRepoWriter "markReleaseSeen(repo, tag) (only after publish succeeds; consumption is async)"
        notifier.scanner.scannerRepoWriter -> notifier.db "UPDATE repositories.last_seen_tag"
        notifier.notificationSvc.consumer -> notifier.rabbitmq "Consume next message"
        notifier.notificationSvc.consumer -> notifier.notificationSvc.sendEmailHandler "invoke(message)"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.ledger "claim(key)"
        notifier.notificationSvc.ledger -> notifier.notificationDb "claim: INSERT release_notifications ... ON CONFLICT DO UPDATE"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.renderer "render email"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.mailer "send email"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.ledger "markSent / record dedupe"
        notifier.notificationSvc.ledger -> notifier.notificationDb "UPDATE release_notifications SET sent_at"
        notifier.notificationSvc.mailer -> notifier.mailhog "SMTP delivery"
    }

    dynamic view confirmSubscriptionSagaFlow {
        title "Dynamic — Confirmed-Subscription Saga"
        description "
            Orchestrated saga: POST subscription starts a STARTED saga atomically,
            the relay publishes SendWelcomeEmail, the notification service sends the
            welcome email and replies WelcomeEmailOutcome, and the saga-worker
            confirms (CONFIRMED) or compensates (CANCELLED).
        "

        user -> notifier.httpApi.middleware "POST /api/subscriptions with X-API-Key"
        notifier.httpApi.middleware -> notifier.httpApi.subscriptionCtrl "Authenticated, forward to controller"
        notifier.httpApi.subscriptionCtrl -> notifier.httpApi.commandBus "dispatch SubscribeCommand"
        notifier.httpApi.commandBus -> notifier.httpApi.subscriptionRepo "create(...) — ONE transaction with the saga start"
        notifier.httpApi.subscriptionRepo -> notifier.db "INSERT subscriptions(status=pending)"
        notifier.httpApi.commandBus -> notifier.httpApi.sagaStore "start saga (same transaction)"
        notifier.httpApi.sagaStore -> notifier.db "INSERT enrollment_sagas(state=started)"
        notifier.httpApi.subscriptionCtrl -> user "201 { ..., status: pending } (never blocks on broker)"

        notifier.sagaWorker.sagaLoop -> notifier.sagaWorker.relayUseCase "relay tick"
        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.sagaRepo "SELECT sagas WHERE state=started"
        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.welcomeRelay "publish(SendWelcomeEmail)"
        notifier.sagaWorker.welcomeRelay -> notifier.rabbitmq "Publish SendWelcomeEmail/v1 (rk subscription.welcome-email -> queue notifications.welcome-email, confirmed)"
        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.sagaRepo "UPDATE saga state=awaiting_confirmation WHERE state=started"

        notifier.rabbitmq -> notifier.notificationSvc.welcomeConsumer "deliver SendWelcomeEmail/v1"
        notifier.notificationSvc.welcomeConsumer -> notifier.notificationSvc.welcomeHandler "invoke(message)"
        notifier.notificationSvc.welcomeHandler -> notifier.notificationSvc.welcomeLedger "claim(subscriptionId) — atomic ON CONFLICT"
        notifier.notificationSvc.welcomeLedger -> notifier.notificationDb "INSERT welcome_notifications"
        notifier.notificationSvc.welcomeHandler -> notifier.notificationSvc.welcomeRenderer "render welcome email"
        notifier.notificationSvc.welcomeHandler -> notifier.notificationSvc.mailer "send welcome email"
        notifier.notificationSvc.mailer -> notifier.mailhog "SMTP delivery"
        notifier.notificationSvc.welcomeHandler -> notifier.notificationSvc.welcomeLedger "markSent"
        notifier.notificationSvc.welcomeHandler -> notifier.notificationSvc.outcomePublisher "publish WelcomeEmailOutcome{sent|failed}"
        notifier.notificationSvc.outcomePublisher -> notifier.rabbitmq "Publish WelcomeEmailOutcome/v1 (rk subscription.welcome-email.reply -> queue notifications.welcome-email-reply)"

        notifier.rabbitmq -> notifier.sagaWorker.outcomeConsumer "deliver WelcomeEmailOutcome/v1"
        notifier.sagaWorker.outcomeConsumer -> notifier.sagaWorker.sagaCommandBus "dispatch HandleWelcomeEmailOutcomeCommand"
        notifier.sagaWorker.sagaCommandBus -> notifier.sagaWorker.outcomeHandler "handle reply (ONE transaction)"
        notifier.sagaWorker.outcomeHandler -> notifier.sagaWorker.confirmationWriter "confirm/cancel WHERE status=pending"
        notifier.sagaWorker.confirmationWriter -> notifier.db "UPDATE subscriptions SET status=confirmed|cancelled"
        notifier.sagaWorker.outcomeHandler -> notifier.sagaWorker.sagaRepo "complete/compensate WHERE state IN (started,awaiting_confirmation)"
        notifier.sagaWorker.sagaRepo -> notifier.db "UPDATE enrollment_sagas SET state=completed|compensated"

        notifier.sagaWorker.sagaLoop -> notifier.sagaWorker.sweepUseCase "sweep timed-out sagas (no reply by T → compensate)"
        notifier.sagaWorker.sweepUseCase -> notifier.sagaWorker.confirmationWriter "cancel swept subscription (ONE transaction with the compensate)"
        notifier.sagaWorker.sweepUseCase -> notifier.sagaWorker.sagaRepo "compensate saga (same transaction)"
    }

    dynamic view syncWelcomeEmailFlow {
        title "Dynamic — Synchronous Welcome-Email Send (gRPC / REST)"
        description "
            Opt-in synchronous welcome-email transports selected by
            WELCOME_EMAIL_TRANSPORT (rest|grpc). The unchanged
            RelayPendingWelcomeEmails use-case calls whichever WelcomeEmailRelay
            adapter is bound; the rest/grpc adapters BLOCK for sent|failed and
            then drive the saga in-thread via HandleWelcomeEmailOutcomeCommand.
            The default rabbit path (async, see Confirmed-Subscription Saga)
            is unchanged. After publish() returns, the relay use-case still
            issues its markPublished UPDATE (WHERE state=started) — a
            guaranteed no-op here because the in-thread outcome already drove
            the saga terminal.
        "

        notifier.sagaWorker.sagaLoop -> notifier.sagaWorker.relayUseCase "relay tick (transport=rest|grpc)"
        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.sagaRepo "SELECT due sagas"

        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.grpcWelcomeRelay "publish(SendWelcomeEmail) (transport=grpc)"
        notifier.sagaWorker.grpcWelcomeRelay -> notifier.notificationGrpc.welcomeGrpcSvc "SendWelcomeEmail RPC (deadline + bounded retry)"
        notifier.notificationGrpc.welcomeGrpcSvc -> notifier.notificationGrpc.grpcWelcomeHandler "invoke unchanged handler"
        notifier.notificationGrpc.grpcWelcomeHandler -> notifier.notificationGrpc.grpcWelcomeLedger "claim(subscriptionId) — atomic ON CONFLICT"
        notifier.notificationGrpc.grpcWelcomeLedger -> notifier.notificationDb "INSERT welcome_notifications"
        notifier.notificationGrpc.grpcWelcomeHandler -> notifier.notificationGrpc.grpcWelcomeRenderer "render welcome email"
        notifier.notificationGrpc.grpcWelcomeHandler -> notifier.notificationGrpc.grpcWelcomeMailer "send welcome email"
        notifier.notificationGrpc.grpcWelcomeMailer -> notifier.mailhog "SMTP delivery"
        notifier.notificationGrpc.grpcWelcomeHandler -> notifier.notificationGrpc.grpcWelcomeLedger "markSent"
        notifier.notificationGrpc.welcomeGrpcSvc -> notifier.sagaWorker.grpcWelcomeRelay "SendWelcomeEmailResponse{outcome=sent|failed}"
        notifier.sagaWorker.grpcWelcomeRelay -> notifier.sagaWorker.sagaCommandBus "dispatch HandleWelcomeEmailOutcomeCommand (definitive outcome, transport=grpc)"

        notifier.sagaWorker.relayUseCase -> notifier.sagaWorker.restWelcomeRelay "publish(SendWelcomeEmail) (transport=rest)"
        notifier.sagaWorker.restWelcomeRelay -> notifier.notificationSvc.welcomeRestController "POST /internal/welcome-emails (deadline + bounded retry)"
        notifier.notificationSvc.welcomeRestController -> notifier.notificationSvc.welcomeHandler "invoke unchanged handler"
        notifier.notificationSvc.welcomeRestController -> notifier.sagaWorker.restWelcomeRelay "200 { outcome: sent|failed } (409 on in-flight)"
        notifier.sagaWorker.restWelcomeRelay -> notifier.sagaWorker.sagaCommandBus "dispatch HandleWelcomeEmailOutcomeCommand (definitive outcome, transport=rest)"
        notifier.sagaWorker.sagaCommandBus -> notifier.sagaWorker.outcomeHandler "handle outcome (ONE transaction)"
        notifier.sagaWorker.outcomeHandler -> notifier.sagaWorker.confirmationWriter "confirm/cancel WHERE status=pending"
        notifier.sagaWorker.confirmationWriter -> notifier.db "UPDATE subscriptions SET status=confirmed|cancelled"
        notifier.sagaWorker.outcomeHandler -> notifier.sagaWorker.sagaRepo "complete/compensate saga"
        notifier.sagaWorker.sagaRepo -> notifier.db "UPDATE enrollment_sagas SET state=completed|compensated"
    }
}
