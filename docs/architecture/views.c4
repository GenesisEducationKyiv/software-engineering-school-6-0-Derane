views {
    view index {
        title "System Landscape"
        description "
            Subscriber, GitHub, and the system boundary.
        "
        include
            user,
            github,
            notifier
    }

    view containers of notifier {
        title "Container View — GitHub Release Notifier"
        description "
            Final runtime topology after notification-service extraction.
        "
        include
            *,
            user,
            github
    }

    view httpApiComponents of notifier.httpApi {
        title "Component View — HTTP API"
        description "
            HTTP edge and its bus/repository integration points.
        "
        include
            *,
            user,
            notifier.db,
            notifier.redis,
            github
    }

    view scannerComponents of notifier.scanner {
        title "Component View — Scanner Worker"
        description "
            Scanner-side publish path into RabbitMQ.
        "
        include
            *,
            notifier.db,
            notifier.redis,
            github,
            notifier.rabbitmq
    }

    view grpcApiComponents of notifier.grpcApi {
        title "Component View — gRPC API"
        description "
            Components inside the gRPC API container.
            bin/grpc.php builds its own DI container, so
            SubscriptionService / SubscriptionRepository / GitHubService
            are separate runtime instances from the HTTP API.
        "
        include
            *,
            user,
            notifier.db,
            notifier.redis,
            github
    }

    view notificationServiceComponents of notifier.notificationSvc {
        title "Component View — Notification Service"
        description "
            Consumer, handler, ledger, renderer, and mailer inside apps/notification.
        "
        include
            *,
            notifier.rabbitmq,
            notifier.notificationDb,
            notifier.mailhog
    }

    dynamic view createSubscriptionFlow {
        title "Dynamic — Create Subscription"
        description "HTTP subscription flow through controller, buses, GitHub validation, and persistence."
        user -> notifier.httpApi.middleware "POST /api/subscriptions with X-API-Key"
        notifier.httpApi.middleware -> notifier.httpApi.subscriptionCtrl "Authenticated, forward to controller"
        notifier.httpApi.subscriptionCtrl -> notifier.httpApi.commandBus "dispatch SubscribeCommand"
        notifier.httpApi.commandBus -> notifier.httpApi.releaseSource "repositoryExists(owner/repo)?"
        notifier.httpApi.releaseSource -> notifier.redis "GET cached response"
        notifier.httpApi.releaseSource -> github "GET /repos/{owner}/{repo} (on cache miss)"
        notifier.httpApi.releaseSource -> notifier.redis "SET response (on cache miss)"
        notifier.httpApi.commandBus -> notifier.httpApi.subscriptionRepo "create(email, owner/repo)"
        notifier.httpApi.subscriptionRepo -> notifier.db "INSERT INTO repositories ON CONFLICT DO NOTHING (ensureRepositoryExists)"
        notifier.httpApi.subscriptionRepo -> notifier.db "INSERT INTO subscriptions ON CONFLICT DO NOTHING RETURNING ..."
        notifier.httpApi.subscriptionCtrl -> user "201 Created"
    }

    dynamic view publishAndSendFlow {
        title "Dynamic — Publish And Send Release Notification"
        description "
            Scanner-side publish followed by notification-service consume,
            dedupe, and SMTP delivery.
        "

        notifier.scanner.cliRunner -> notifier.scanner.scanHandler "dispatch ScanReleasesCommand"
        notifier.scanner.scanHandler -> notifier.scanner.scannerRepo "getRepositoriesToScan(batchSize)"
        notifier.scanner.scannerRepo -> notifier.db "SELECT repositories"
        notifier.scanner.scanHandler -> notifier.scanner.releaseDetector "getLatestRelease(owner/repo)"
        notifier.scanner.releaseDetector -> notifier.redis "GET cached response"
        notifier.scanner.releaseDetector -> github "GET /repos/.../releases/latest (on cache miss)"
        notifier.scanner.releaseDetector -> notifier.redis "SET response with TTL (on cache miss)"
        notifier.scanner.scanHandler -> notifier.scanner.scannerRepo "getRepositoryInfo(repo)"
        notifier.scanner.scannerRepo -> notifier.db "SELECT last_seen_tag"
        notifier.scanner.scanHandler -> notifier.scanner.publishListener "dispatch NewReleaseDetected"
        notifier.scanner.publishListener -> notifier.scanner.rabbitPublisher "publish SendReleaseEmail/v1 per subscriber"
        notifier.scanner.rabbitPublisher -> notifier.rabbitmq "Publish to notifications.send-email"
        notifier.notificationSvc.consumer -> notifier.rabbitmq "Consume next message"
        notifier.notificationSvc.consumer -> notifier.notificationSvc.sendEmailHandler "invoke(message)"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.ledger "hasBeenSent?"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.renderer "render email"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.mailer "send email"
        notifier.notificationSvc.sendEmailHandler -> notifier.notificationSvc.ledger "markSent / record dedupe"
        notifier.notificationSvc.ledger -> notifier.notificationDb "INSERT release_notifications"
        notifier.notificationSvc.mailer -> notifier.mailhog "SMTP delivery"
        notifier.scanner.scanHandler -> notifier.scanner.scannerRepo "updateLastSeenTag(repo, tag) (only after publish succeeds)"
        notifier.scanner.scannerRepo -> notifier.db "UPDATE repositories.last_seen_tag"
    }
}
