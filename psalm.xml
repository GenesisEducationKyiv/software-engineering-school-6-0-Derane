<?xml version="1.0"?>
<psalm
    errorLevel="1"
    phpVersion="8.4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <directory name="gen" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- gen/ is buf-generated: scanned for symbol resolution, not analyzed (RD7). -->
            <directory name="gen" />
        </ignoreFiles>
    </projectFiles>
</psalm>
